# ==============================================================================
# VARIABLES DE ENTORNO — CORPORATE BILLING SERVICE
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo como .env: cp .env.example .env
# 2. Configura los valores correspondientes para tu entorno.
# 3. NUNCA subas el archivo .env a tu repositorio de control de versiones.
# ==============================================================================

# --- Base de Datos PostgreSQL ---
POSTGRES_DB=facturacion
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=billing_password_secreta_ejemplo
POSTGRES_PORT=5432

# --- Aplicación Spring Boot ---
APP_PORT=8080
SPRING_PROFILES_ACTIVE=docker
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom

# --- Conectividad con el Sistema de Órdenes (Entrada) ---
# En Windows/Mac usa host.docker.internal para servicios que corren en el host fuera de Docker.
# En Linux, docker-compose.yml ya incluye extra_hosts para mapear host.docker.internal al gateway.
ORDENES_BASE_URL=http://host.docker.internal:8081
ORDENES_API_KEY=token_ordenes_desarrollo_ejemplo
ORDENES_TIMEOUT_MS=5000
ORDENES_REINTENTOS=3

# --- Rutas de Carpetas Compartidas en el Host (Bind Mounts) ---
# Carpeta de origen donde Siigo deposita PDF y archivos de datos (solo lectura).
# En producción corresponde a la ruta UNC (ej. \\SERVIDOR\Facturas) o el punto de montaje real en Linux.
LOCAL_SIIGO_CARPETA_PATH=./storage/siigo_compartida

# Carpeta local persistente y escribible donde el servicio conserva las copias de los PDF recibidos.
LOCAL_SIIGO_PDF_PATH=./storage/siigo-pdfs

# Ruta local en el host para archivos de importación de órdenes y exportación de planos
LOCAL_FILES_PATH=./storage/files

# --- Autenticación y Autorización (OAuth2 / Resource Server JWT RS256) ---
AUTH_ISSUER_URI=https://qa.sistemaspalacios.com
AUTH_JWKS_URI=https://qa.sistemaspalacios.com/oauth2/jwks
AUTH_AUDIENCE=corporate-billing-service

# --- CORS (Orígenes Permitidos) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,http://localhost:3000,http://localhost:5173,https://panel.sistemaspalacios.com,https://pasarela.sistemaspalacios.com

# Administrador inicial (rol SUPER_ADMIN). Se vincula por usuario o correo con la cuenta del microservicio de autenticación.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=

